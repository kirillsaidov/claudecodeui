# docker
CONTAINER_NAME=claude-ui-__NAME__
IMAGE=cloudcli-sandbox:claude-code

# ports
SERVER_PORT=10001
VITE_PORT=10002

# volumes
WORKSPACE_VOLUME=/home/administrator/STORAGE/CLAUDE_CODE_WEBUI_DATA/__NAME__/workspace
DB_VOLUME=/home/administrator/STORAGE/CLAUDE_CODE_WEBUI_DATA/__NAME__/cloudcli
CLAUDE_VOLUME=/home/administrator/STORAGE/CLAUDE_CODE_WEBUI_DATA/__NAME__/claude
